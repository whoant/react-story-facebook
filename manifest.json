{
  "manifest_version": 3,
  "name": "React Story Facebook",
  "description": "Inject custom reactions or content into Facebook Stories.",
  "version": "2.0.0",
  "icons": {
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["db/emoji.json"],
      "matches": ["https://www.facebook.com/*"]
    }
  ],
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ]
}